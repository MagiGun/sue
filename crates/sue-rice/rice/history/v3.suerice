# Sue v1.0 "Faustian Enigma": default rice
# "A jack of all trades is a master of none,
#  but oftentimes better than a master of one."
#
# sue-rice format 3
#
# Every key below is a live control in Settings. Metadata lives in the
# trailing comment:   [min..max]  slider       {a|b|c}  choice
#                     @color @keybind @shader @text   force a widget
# Text after the metadata becomes the description shown in Settings.

[general]
workspace_dir = ""             # @text Folder the Files drawer opens in (empty for your home folder)
autosave_seconds = 30          # [0..600] Save notes this often, in seconds (0 turns autosave off)
confirm_on_exit = true         # Ask before closing the window

[launchpad]
boot_mode = "canvas"           # @text Mode Sue opens in: "canvas", or the id of an applet with a mode

[profile]
hardware = "auto"              # {auto|high-refresh|balanced|legacy-low-spec|mobile-battery-saver} Frame pacing and effect budget

[display]
frame_rate_cap = 0             # [0..360] Highest frame rate while animating (0 follows the hardware profile)
ui_scale = 1.0                 # [0.75..2.0] Interface scale on top of the system scale
gpu_preference = "auto"        # {auto|integrated|discrete} GPU that draws the window; auto uses the display's GPU (applies after a restart)

[motion]
instant_transitions = false    # Snap drawers, pills and the camera in 0 ms instead of animating them
animation_speed = 1.0          # [0.25..4.0] Speed of every spring animation
spring_stiffness = 260.0       # [10.0..1000.0] Drawer and pill spring constant k
spring_damping = 32.0          # [0.0..120.0] Drawer and pill damping coefficient c
camera_stiffness = 600.0       # [10.0..1000.0] Camera spring constant k (frames an entity in about 250 ms)
camera_damping = 49.0          # [0.0..120.0] Camera damping coefficient c
settle_grace_ms = 300          # [0..2000] Keep drawing this long after the last change (ms)
caret_blink_ms = 530           # [0..2000] Caret blink interval (0 keeps the caret solid)
message_seconds = 4            # [1..30] How long messages stay in the status bar (s)

[layout]
padding = 8                    # [2..24] Space inside drawers, pills and controls (px)
border_width = 1               # [0..4] Hairline border thickness (px)
control_radius = 4.0           # [0.0..12.0] Corner rounding of buttons and fields (px)
pill_radius = 12.0             # [0.0..24.0] Corner rounding of floating pills and cards (px)
pill_height = 34               # [24..64] Height of the floating pills (px)
pill_gap = 12                  # [0..64] Space between a selected entity and its pill (px)
rail_width = 36                # [28..72] Width of the activity rails (px)
left_drawer_width = 260        # [160..640] Left drawer width (px)
right_drawer_width = 280       # [160..720] Right drawer width (px)
timeline_height = 240          # [120..600] Bottom timeline height (px)
status_bar_height = 22         # [16..48] Height of the status bar (px)
min_canvas_width = 420         # [240..1600] Narrowest canvas before desktop drawers shrink (px)
drawer_max_fraction = 0.85     # [0.5..1.0] Widest a phone drawer may be, as a share of the screen
sheet_max_fraction = 0.5       # [0.2..0.9] Tallest the phone timeline sheet may be, as a share of the screen
settings_sidebar_width = 190   # [140..360] Width of the category list in Settings (px)
radial_radius = 104            # [64..200] Radius of the right-click marking menu (px)
shadow_blur = 18               # [0..48] Blur of the shadow under pills and windows (px)

[canvas]
zoom_min = 0.1                 # [0.05..1.0] Farthest the canvas zooms out (0.1 is 10%)
zoom_max = 32.0                # [2.0..64.0] Closest the canvas zooms in (32 is 3200%)
zoom_step = 0.18               # [0.02..1.0] Zoom change per mouse-wheel notch (natural log)
grid_spacing = 32              # [8..256] Distance between grid dots at 100% (px)
grid_style = "dots"            # {dots|lines|none} Canvas background
frame_margin = 48              # [0..400] Space kept around an entity the camera frames (px)

[colors]
void = "#0a0a0a"               # Canvas background
panel = "#111111"              # Drawers and panels
pill = "#181818"               # Floating pills, cards and entity frames
hover = "#262626"              # Hovered controls
active = "#333333"             # Pressed and chosen controls
border = "#262626"             # Hairline borders
border_active = "#ffffff"      # Borders of selected entities and focused controls
text = "#ffffff"               # Primary text and active icons
muted = "#808080"              # Secondary text
selection = "#404040"          # Text selection highlight
selection_text = "#ffffff"     # Text inside a selection
grid = "#262626"               # Canvas grid dots and lines
shadow = "#000000"             # Shadow under floating surfaces

[typography]
ui_font = "Ubuntu Light"       # {Ubuntu Light|Hack} Interface font (bundled)
ui_size = 13                   # [8..32] Interface text size (px)
small_size = 11                # [8..24] Caption and status bar text size (px)
heading_size = 18              # [12..48] Heading size (px)
mono_size = 12                 # [8..32] Code and hex text size (px)
document_size = 15             # [8..48] Default text size of new documents (px)

[input]
wheel_line_px = 48             # [8..200] Pixels scrolled per mouse-wheel notch in lists

[files]
show_hidden = false            # List files and folders whose names start with a dot

[io]
jxl_effort = 7                 # [1..9] JPEG XL effort for conversions (higher is smaller and slower)
jpeg_lossless_transcode = true # Recompress JPEG to JPEG XL bit for bit when a recompression codec is installed
jpeg_quality = 90              # [10..100] JPEG quality for conversions to .jpg
byte_map_width = 64            # [16..1024] Columns in the byte map of unknown files
max_ingest_mib = 512           # [1..4096] Largest file Sue opens (MiB)
convert_dir = ""               # @text Folder for converted files (empty saves next to the source)

[audio]
output_device = ""             # @text Output device (empty for the system default)
sample_rate = "48000"          # {44100|48000|96000} Sample rate (Hz)
buffer_frames = "512"          # {128|256|512|1024|2048} Buffer size (frames per callback)
realtime_priority = true       # Ask the OS to schedule the audio thread in real time
volume = 0.8                   # [0.0..1.0] Player volume

[ai]
backend = "auto"               # {auto|cpu-simd|vulkan|cuda|metal} Where AI kernels run
model_dir = ""                 # @text Folder with offline models (empty for Sue's data folder)
vram_budget_mib = 2048         # [256..65536] Most GPU memory AI models may use (MiB)

[packages]
require_signatures = true      # Only accept packages with a valid Ed25519 signature

[paint]
width = 960                    # [64..8192] Width of new paint layers (px)
height = 600                   # [64..8192] Height of new paint layers (px)
brush_size = 6                 # [1..128] Starting brush size (px)

[sue_paint]
width = 1600                   # [1..10000] Width of new illustrations (px)
height = 1200                  # [1..10000] Height of new illustrations (px)
dpi = 72                       # [1..2400] Resolution of new illustrations (dpi)

[notes]
font_size = 14                 # [8..48] Note text size (px)

[keys]
toggle_left_drawer = "Ctrl+B"  # @keybind Show or hide the left drawer
toggle_right_drawer = "Ctrl+Alt+B" # @keybind Show or hide the right drawer
toggle_timeline = "Ctrl+J"     # @keybind Show or hide the timeline
command_palette = "Tab"        # @keybind Open the command palette
command_palette_alt = "/"      # @keybind Open the command palette (alternative)
open_settings = "Ctrl+,"       # @keybind Open Settings
open_file = "Ctrl+O"           # @keybind Open a file
save = "Ctrl+S"                # @keybind Save the project
quit = "Ctrl+Q"                # @keybind Quit Sue
undo = "Ctrl+Z"                # @keybind Undo the last change
redo = "Ctrl+Shift+Z"          # @keybind Redo
redo_alt = "Ctrl+Y"            # @keybind Redo (alternative)
play_pause = "Space"           # @keybind Play or pause the timeline (tap; hold and drag pans)
reset_camera = "Ctrl+0"        # @keybind Frame everything on the canvas
delete = "Delete"              # @keybind Remove the selected entity from the canvas
