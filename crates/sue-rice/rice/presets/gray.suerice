# Gray: the mid grays painting studios use, so colors read true.
[colors]
void = "#2b2b2b"
panel = "#3a3a3a"
pill = "#444444"
hover = "#505050"
active = "#5e5e5e"
border = "#2a2a2a"
border_active = "#d8d8d8"
text = "#e6e6e6"
muted = "#a4a4a4"
selection = "#6a6a6a"
selection_text = "#ffffff"
grid = "#474747"
shadow = "#141414"
