# Sue v1.0 "Faustian Enigma": default rice
# "A jack of all trades is a master of none,
#  but oftentimes better than a master of one."
#
# sue-rice format 5
#
# Every key below is a live control in Settings. Metadata lives in the
# trailing comment:   [min..max]  slider       {a|b|c}  choice
#                     @color @keybind @shader @text   force a widget
# Text after the metadata becomes the description shown in Settings.

[general]
confirm_on_exit = true         # Ask before closing the window
language = "system"            # @text Sue's language, which every studio and tool follows unless set apart (system follows the system's language)
autosave_seconds = 60          # [0..3600] Keep unsaved work this often, so the Hub can bring it back (s; 0 turns autosave off)

[launchpad]
pinned = ""                    # @text The studio or tool Sue opens straight into (the pin on its box in the Hub; empty opens the Hub)
recent_count = 8               # [0..50] How many recent files and projects the Hub lists (0 hides the list)

[profile]
hardware = "auto"              # {auto|high-refresh|balanced|legacy-low-spec|mobile-battery-saver} Frame pacing and effect budget

[display]
frame_rate_cap = 0             # [0..360] Highest frame rate while animating (0 follows the performance preference)
ui_scale = 1.0                 # [0.75..2.0] Interface scale on top of the system scale
interface = "auto"             # {auto|desktop|tablet|phone} Layout: auto follows the device (touch layouts on tablets and phones); pick one to switch
phone_frame = false            # On a computer, draw the phone layout in a phone-wide column in the middle of the window
gpu_preference = "auto"        # {auto|integrated|discrete} GPU that draws the window; auto uses the display's GPU (applies after a restart)

[motion]
instant_transitions = false    # Snap pages, menus and windows in 0 ms instead of animating them
animation_speed = 1.0          # [0.25..4.0] Speed of every spring animation
spring_stiffness = 260.0       # [10.0..1000.0] Spring constant k of every animation
spring_damping = 32.0          # [0.0..120.0] Damping coefficient c of every animation
settle_grace_ms = 300          # [0..2000] Keep drawing this long after the last change (ms)
caret_blink_ms = 530           # [0..2000] Caret blink interval (0 keeps the caret solid)
smooth_caret = true            # Let the text caret glide to its new place instead of jumping
caret_glide_ms = 100           # [20..400] How long the caret takes to glide to its new place (ms; less is faster)
message_seconds = 4            # [1..30] How long messages stay in the status bar (s)

[layout]
padding = 8                    # [2..24] Space inside bars, pills and controls (px)
border_width = 1               # [0..4] Hairline border thickness (px)
control_radius = 4.0           # [0.0..12.0] Corner rounding of buttons and fields (px)
pill_radius = 12.0             # [0.0..24.0] Corner rounding of windows, menus and pill buttons (px)
pill_height = 34               # [24..64] Height of pill buttons (px)
bar_height = 28                # [22..64] Height of the top bar with the Sue button and the menus (px; touch layouts make it taller)
status_bar_height = 22         # [16..48] Height of the status bar (px)
settings_sidebar_width = 190   # [140..360] Width of the category list in Settings (px)
shadow_blur = 18               # [0..48] Blur of the shadow under menus and windows (px)

[colors]
void = "#0a0a0a"               # Page background
panel = "#111111"              # Bars and panels
pill = "#181818"               # Menus, boxes and floating surfaces
hover = "#262626"              # Hovered controls
active = "#333333"             # Pressed and chosen controls
border = "#262626"             # Hairline borders
border_active = "#ffffff"      # Borders of hovered boxes and focused controls
text = "#ffffff"               # Primary text and active icons
muted = "#808080"              # Secondary text
selection = "#404040"          # Text selection highlight
selection_text = "#ffffff"     # Text inside a selection
grid = "#262626"               # Grid lines in curve editors
shadow = "#000000"             # Shadow under floating surfaces

[typography]
ui_font = "Ubuntu Light"       # {Ubuntu Light|Hack} Interface font (bundled)
ui_size = 13                   # [8..32] Interface text size (px)
small_size = 11                # [8..24] Caption and status bar text size (px)
heading_size = 18              # [12..48] Heading size (px)
mono_size = 12                 # [8..32] Monospace text size (px)

[input]
wheel_line_px = 48             # [8..200] Pixels scrolled per mouse-wheel notch in lists

[io]
jxl_effort = 7                 # [1..9] JPEG XL effort for conversions (higher is smaller and slower)
jpeg_lossless_transcode = true # Recompress JPEG to JPEG XL bit for bit when a recompression codec is installed
jpeg_quality = 90              # [10..100] JPEG quality for conversions to .jpg
byte_map_width = 64            # [16..1024] Columns in the byte map of unknown files
max_ingest_mib = 512           # [1..4096] Largest file Sue opens (MiB)
convert_dir = ""               # @text Folder for converted files (empty saves next to the source)

[audio]
output_device = ""             # @text Output device (empty for the system default)
sample_rate = "48000"          # {44100|48000|96000} Sample rate (Hz)
buffer_frames = "512"          # {128|256|512|1024|2048} Buffer size (frames per callback)
realtime_priority = true       # Ask the OS to schedule the audio thread in real time
volume = 0.8                   # [0.0..1.0] Volume of everything Sue plays

[packages]
require_signatures = true      # Only accept packages with a valid Ed25519 signature

[sue_paint]
width = 1600                   # [1..10000] Width of new illustrations (px)
height = 1200                  # [1..10000] Height of new illustrations (px)
dpi = 72                       # [1..2400] Resolution of new illustrations (dpi)
materials_dir = ""             # @text Where Sue Paint keeps its materials and brush tips (empty: its own folder)
save_format = "clip"           # {clip|sue} How Save keeps a picture: a Clip Studio Paint .clip file, or a Sue project
touch_mode = "simple"          # {simple|studio} Sue Paint on phones and tablets: Simple Mode or Studio Mode
custom_key_1 = "edit.undo"     # @text The command Studio Mode's key T1 runs
custom_key_2 = "edit.redo"     # @text The command Studio Mode's key T2 runs
custom_key_3 = "select.all"    # @text The command Studio Mode's key T3 runs
custom_key_4 = "select.none"   # @text The command Studio Mode's key T4 runs
custom_key_5 = "layer.new"     # @text The command Studio Mode's key T5 runs
custom_key_6 = "view.fit"      # @text The command Studio Mode's key T6 runs
custom_key_7 = "view.flip_h"   # @text The command Studio Mode's key T7 runs
theme = "gray"                 # {gray|sue-theme|void|graphite|paper|custom} Sue Paint's colors: Gray, Sue's own theme (follows it), a preset, or Custom (below)
pen_pressure = "0,0 0.4,0.5 1,1" # @text Pen pressure curve for every tool, as pressure,output points (File, Pen Pressure Settings draws it)
alt_tool = "eyedropper"        # {eyedropper|eraser|none} What Alt while drawing does on the canvas (File, Modifier Key Settings)
space_tool = "hand"            # {hand|none} What Space does on the canvas (File, Modifier Key Settings)
ctrl_shift = "pick_layer"      # {pick_layer|none} What Ctrl+Shift click does on the canvas (File, Modifier Key Settings)
language = "sue"              # @text Language: sue follows Sue's language, a language tag sets this one apart

[sue_paint_colors]
void = "#2b2b2b"               # Around the picture
panel = "#3a3a3a"              # Palettes and menus
pill = "#444444"               # Fields, chips and cards
hover = "#505050"              # Hovered controls
active = "#5e5e5e"             # Pressed and chosen controls
border = "#2a2a2a"             # Hairline borders
border_active = "#d8d8d8"      # Borders of chosen and focused controls
text = "#e6e6e6"               # Primary text and active icons
muted = "#a4a4a4"              # Secondary text
selection = "#6a6a6a"          # Text selection highlight
selection_text = "#ffffff"     # Text inside a selection
grid = "#474747"               # Grids and rulers
shadow = "#141414"             # Shadow under floating surfaces

[sue_writer]
theme = "sue-theme"            # {sue-theme|gray|void|graphite|paper} Sue Writer's colors: Sue's own theme (follows it) or a preset
smart_quotes = true            # Turn straight quotes into curly ones while typing
dark_paper = false             # Show the page in the theme's dark colors instead of white paper
spell_check = true             # Underline misspelled words while typing
language = "sue"              # @text Language: sue follows Sue's language, a language tag sets this one apart

[image_viewer]
language = "sue"              # @text Language: sue follows Sue's language, a language tag sets this one apart

[convert]
language = "sue"              # @text Language: sue follows Sue's language, a language tag sets this one apart

[keys]
command_palette = "Tab"        # @keybind Open the command palette
command_palette_alt = "/"      # @keybind Open the command palette (alternative)
open_settings = "Ctrl+,"       # @keybind Open Settings
open_file = "Ctrl+O"           # @keybind Open a file
save = "Ctrl+S"                # @keybind Save the project
quit = "Ctrl+Q"                # @keybind Quit Sue
undo = "Ctrl+Z"                # @keybind Undo the last change
redo = "Ctrl+Shift+Z"          # @keybind Redo
redo_alt = "Ctrl+Y"            # @keybind Redo (alternative)

[sue_paint_keys]
help_shortcuts = "Ctrl+Alt+Shift+K or F1 or Alt+I" # @keybind Keyboard Shortcuts
file_preferences = "Ctrl+K"    # @keybind Preferences
file_save_as = "Ctrl+Shift+S or Ctrl+Alt+S or Alt+Shift+S" # @keybind Save Project As
file_print = "Ctrl+P"          # @keybind Print
layer_new = "Ctrl+Shift+N"     # @keybind Raster Layer
file_new = "Ctrl+N"            # @keybind New
file_close = "Ctrl+W"          # @keybind Close
edit_transform_free = "Ctrl+Shift+T" # @keybind Free Transform
edit_transform_scale = "Ctrl+T" # @keybind Scale/Rotate
filter_hue = "Ctrl+U"          # @keybind Hue/Saturation/Luminosity
select_invert = "Ctrl+Shift+I or Shift+F7" # @keybind Invert Selected Area
filter_invert = "Ctrl+I"       # @keybind Reverse Gradient
edit_cut = "Ctrl+X or F2"      # @keybind Cut
edit_copy = "Ctrl+C or F3"     # @keybind Copy
edit_paste = "Ctrl+V or F4"    # @keybind Paste
edit_clear = "Ctrl+Delete or Ctrl+Backspace or Delete or Backspace" # @keybind Clear
edit_fill = "Shift+Delete or Shift+Backspace or Alt+Delete or Alt+Backspace" # @keybind Fill
layer_toggle_clip = "Ctrl+Alt+G" # @keybind Clip to Layer Below
layer_folder_insert = "Ctrl+G" # @keybind Create Folder and Insert Layer
layer_merge_visible = "Ctrl+Shift+E" # @keybind Merge Visible to New Layer
layer_merge_selected = "Alt+Shift+E" # @keybind Merge Selected Layers
layer_merge_down = "Ctrl+E"    # @keybind Merge with Layer Below
layer_select_above = "Alt+]"   # @keybind Select Layer Above
layer_select_below = "Alt+["   # @keybind Select Layer Below
layer_order_up = "Ctrl+]"      # @keybind Move Up
layer_order_down = "Ctrl+["    # @keybind Move Down
select_again = "Ctrl+Shift+D"  # @keybind Reselect
select_all = "Ctrl+A"          # @keybind All
select_none = "Ctrl+D"         # @keybind Deselect
view_actual = "Ctrl+Alt+0"     # @keybind 100%
view_fit = "Ctrl+0"            # @keybind Fit to Screen
view_rotate_reset = "Ctrl+Shift+2" # @keybind Reset Rotation
view_zoom_in = "Ctrl++ or Ctrl+= or Ctrl+;" # @keybind Zoom In
view_zoom_out = "Ctrl+-"       # @keybind Zoom Out
view_ruler_bar = "Ctrl+R"      # @keybind Ruler Bar
view_snap_ruler = "Ctrl+1"     # @keybind Snap to Ruler
view_snap_special = "Ctrl+2"   # @keybind Snap to Special Ruler
view_snap_grid = "Ctrl+3"      # @keybind Snap to Grid
view_rotate_left = "-"         # @keybind Rotate Left
view_rotate_right = "="        # @keybind Rotate Right
window_prev_tab = "Ctrl+Shift+Tab" # @keybind Previous Canvas
window_next_tab = "Ctrl+Tab"   # @keybind Next Canvas
window_hide_menus = "Shift+Tab" # @keybind Hide Menu Bar
window_hide_all = "Tab"        # @keybind Hide All Palettes
tool_zoom = "/"                # @keybind Zoom Tool
tool_hand = "H"                # @keybind Hand Tool
tool_rotate = "R"              # @keybind Rotate Tool
tool_operation = "O"           # @keybind Operation Tool
tool_move_layer = "K"          # @keybind Move Layer Tool
tool_selection = "M"           # @keybind Selection Tool
tool_auto_select = "W"         # @keybind Auto Select Tool
tool_eyedropper = "I"          # @keybind Eyedropper Tool
tool_pen = "P"                 # @keybind Pen and Pencil Tools
tool_brush = "B"               # @keybind Brush, Airbrush and Decoration Tools
tool_eraser = "E"              # @keybind Eraser Tool
tool_blend = "J"               # @keybind Blend Tool
tool_fill = "G"                # @keybind Fill and Gradient Tools
tool_figure = "U"              # @keybind Figure, Frame Border and Ruler Tools
tool_text = "T"                # @keybind Text and Balloon Tools
tool_correct_line = "Y"        # @keybind Correct Line Tool
tool_previous_sub = ","        # @keybind Previous Sub Tool
tool_next_sub = "."            # @keybind Next Sub Tool
color_swap = "X"               # @keybind Swap Main and Sub Color
color_transparent = "C"        # @keybind Drawing or Transparent Color
brush_smaller = "["            # @keybind Smaller Brush
brush_bigger = "]"             # @keybind Bigger Brush

[sue_writer_keys]
binder_new_folder = "Ctrl+Shift+N" # @keybind New Folder
binder_new_doc = "Ctrl+N"      # @keybind New Document
compile_open = "Ctrl+Shift+E"  # @keybind Compile
compile_pdf = "Ctrl+P"         # @keybind PDF
format_bold = "Ctrl+B"         # @keybind Bold
format_italic = "Ctrl+I"       # @keybind Italic
format_underline = "Ctrl+U"    # @keybind Underline
format_strike = "Ctrl+Shift+X" # @keybind Strikethrough
project_split = "Ctrl+Shift+K" # @keybind Split at Selection
format_superscript = "Ctrl+Shift++ or Ctrl+Shift+=" # @keybind Superscript
format_subscript = "Ctrl+="    # @keybind Subscript
format_clear = "Ctrl+Space"    # @keybind Clear Direct Formatting
align_center = "Ctrl+E"        # @keybind Center
align_left = "Ctrl+L"          # @keybind Left
align_right = "Ctrl+R"         # @keybind Right
align_justify = "Ctrl+J"       # @keybind Justify
style_heading1 = "Ctrl+Alt+1"  # @keybind Heading 1
style_heading2 = "Ctrl+Alt+2"  # @keybind Heading 2
style_heading3 = "Ctrl+Alt+3"  # @keybind Heading 3
style_body = "Ctrl+Alt+0"      # @keybind Body Text
insert_footnote = "Ctrl+Alt+F" # @keybind Footnote
insert_endnote = "Ctrl+Alt+D"  # @keybind Endnote
review_comment = "Ctrl+Alt+C"  # @keybind New Comment
review_track = "Ctrl+Shift+C"  # @keybind Record Changes
review_next_misspelling = "F7"  # @keybind Next Misspelling
format_grow = "Ctrl+]"         # @keybind Grow Font
format_shrink = "Ctrl+["       # @keybind Shrink Font
insert_mark_nbsp = "Ctrl+Shift+Space" # @keybind Non-breaking Space
insert_page_break = "Ctrl+Enter" # @keybind Page Break
insert_link = "Ctrl+K"         # @keybind Link
edit_find = "Ctrl+F"           # @keybind Find
edit_replace = "Ctrl+H"        # @keybind Replace
edit_find_previous = "Shift+F3" # @keybind Find Previous
edit_find_next = "F3"          # @keybind Find Next
view_composition = "F11"       # @keybind Composition Mode
view_document = "Ctrl+1"       # @keybind Text
view_corkboard = "Ctrl+2"      # @keybind Corkboard
view_outliner = "Ctrl+3"       # @keybind Outliner
project_snapshot = "Ctrl+5"    # @keybind Take Snapshot
list_bullet = "Ctrl+Shift+L"   # @keybind Bulleted List

[image_viewer_keys]
viewer_next = "Right or Space" # @keybind Next Picture
viewer_previous = "Left"       # @keybind Previous Picture
viewer_fit = "0"               # @keybind Fit to the Window
viewer_actual = "1"            # @keybind Actual Size
viewer_zoom_in = "+ or ="      # @keybind Zoom In
viewer_zoom_out = "-"          # @keybind Zoom Out
viewer_rotate_right = "R"      # @keybind Turn Right
viewer_rotate_left = "Shift+R" # @keybind Turn Left
viewer_crop = "C"              # @keybind Crop
viewer_save_as = "Ctrl+Shift+S" # @keybind Save As
