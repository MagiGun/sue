## extras.rs

starting = # البدء
file-new-makes-illustration-comic-webtoon = ملف، جديد ينشئ رسماً توضيحياً أو قصة مصورة أو ويبتون أو رسوماً متحركة. ملف، فتح يقرأ الصور ومستندات Photoshop مع طبقاتها. عملك يستقر في مشروع Sue: حفظ المشروع يحتفظ بكل صورة وطبقة وصفحة.
tools = # الأدوات
tool-strip-left-holds-tools-sub = شريط الأدوات على اليسار يحمل الأدوات؛ لوحة الأداة الفرعية تحمل تنوعاتها وخصائص الأداة إعداداتها. تختارها المفاتيح كما في Clip Studio Paint: ‏P قلم، B فرشاة، E ممحاة، G تعبئة، M تحديد، K تحريك، I قطارة، R مسطرة، T نص، Y تصحيح الخط.
alt-picks-color-while-drawing-space = مفتاح Alt يلتقط لوناً أثناء الرسم، والمسافة للتمرير، والمسافة مع Shift لتدوير العرض، وCtrl مع المسافة للتكبير وAlt مع المسافة للتصغير. Ctrl+Alt يسحب لتغيير حجم الفرشاة. ملف، إعدادات المفاتيح المعدلة يغير ما يفعله Alt والمسافة وCtrl+Shift.
layers = # الطبقات
raster-layers-hold-pixels-vector-layers = تحمل الطبقات النقطية بكسلات، وتحمل طبقات المتجهات خطوطاً يمكنك تعديلها لاحقاً (تصحيح الخط)، وترسم الطبقات ثلاثية الأبعاد نموذجاً يمكنك تدويره. تجمع المجلدات الطبقات. تضيف لوحة خصائص الطبقة حداً ونغمات ولون تعبير؛ وتخفي الأقنعة أجزاء من الطبقة دون مسحها.
colors = # الألوان
color-wheel-color-slider-color-set = تحدد كل من عجلة الألوان، شريط تمرير الألوان، مجموعة الألوان، لوحتا اللون المتوسط والتقريبي وسجل الألوان اللون الرئيسي. مفتاح X يبدل بين اللونين الرئيسي والفرعي، ومفتاح C يرسم باللون الشفاف.
selections = # التحديدات
selection-tools-make-selection-launcher-under = تنشئ أدوات التحديد تحديداً؛ ويقدم شريط التشغيل أسفله خيارات للخطوة التالية. القناع السريع يلون تحديداً. تحديد، التدرج اللوني يختار حسب اللون.
pages-and-books = # الصفحات والكتب
comic-story-pages-story-menu-adds = القصة المصورة هي مجموعة من الصفحات. تضيف قائمة قصة الصفحات وتحركها وتنسقها، وتصدرها كصور أو PDF أو EPUB. نافذة، لوحة الرسم، قرميد يعرض عدة لوحات رسم معاً.
animation-2 = # الرسوم المتحركة
animation-timeline-new-timeline-starts-animation = الرسوم المتحركة، المخطط الزمني، مخطط زمني جديد يبدأ رسوماً متحركة. كل مجلد رسوم متحركة هو مسار لإطارات الحركة؛ إطار رسوم متحركة جديد يرسم إطاراً جديداً عند الإطار المعروض. يساعد قشر البصل وطاولة الإضاءة فيما بينها. ملف، استيراد، فيلم يجلب ملف GIF أو PNG أو WebP أو AVI كإطارات، ملف، استيراد، صوت يضع صوتاً على المخطط الزمني.
repeating-work = # تكرار العمل
auto-actions-navigator-palette-records-menu = تسجل الإجراءات التلقائية (في لوحة المستكشف) أوامر القوائم وتشغلها ثانية. يحتفظ بنك العناصر بالأدوات الفرعية لإضافتها من جديد. نافذة، مساحة العمل تحتفظ بتخطيط اللوحات حسب الاسم.
exporting = # التصدير
file-export-writes-png-jpeg-jpeg = ملف، تصدير يكتب ملفات PNG وJPEG وJPEG XL وBMP وTIFF وTGA وPSD وPSB. ملف، طباعة يرتب الصفحات على الورق ويفتحها في عارض PDF لديك.
