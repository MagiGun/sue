tools = # 工具
tool-strip-left-holds-tools-sub = 左侧的工具条存放工具；子工具面板存放工具的变化样式，工具属性面板存放其参数设置。按键切换与 Clip Studio Paint 保持一致：P 蘸水笔、B 笔刷、E 橡皮擦、G 填充、M 选择、K 移动、I 吸管、R 标尺、T 文本、Y 修正线。
alt-picks-color-while-drawing-space = 绘画时按住 Alt 拾取颜色，按住空格键滚动，空格加 Shift 旋转视图，Ctrl 加空格放大，Alt 加空格缩小。Ctrl+Alt 拖动调节笔刷大小。“文件” -> “修饰键设置”可自定义 Alt、空格和 Ctrl+Shift 的动作。
layers = # 图层
raster-layers-hold-pixels-vector-layers = 栅格图层存放像素，矢量图层存放可二次编辑的线条（修正线），3D 图层绘制可旋转的模型。图层组用于归类图层。图层属性面板可添加边框、网点和表现色；图层蒙版可在不擦除的情况下隐藏图层的一部分。
colors = # 颜色
color-wheel-color-slider-color-set = 色环、颜色滑块、颜色组、中间色和近似色面板以及颜色历史均可用于设置主颜色。按 X 键切换主颜色与副颜色，按 C 键使用透明色绘制。
selections = # 选区
selection-tools-make-selection-launcher-under = 选择工具用于创建选区；下方的选区起动器提供了后续快捷操作。快速蒙版可以手绘选区。“选择” -> “色彩范围”可按颜色进行选取。
pages-and-books = # 页面与画册
comic-story-pages-story-menu-adds = 漫画是由多个页面构成的多页作品。“作品”菜单可添加、移动和排版页面，并可导出为图像、PDF 或 EPUB。“窗口” -> “画布” -> “平铺”可同时显示多个画布。
animation-2 = # 动画
animation-timeline-new-timeline-starts-animation = “动画” -> “时间轴” -> “新建时间轴”可创建动画。每个动画文件夹都是一个胶片轨道；“新建动画胶片”可在当前指示的帧绘制新胶片。洋葱皮和透光桌可协助中割绘制。“文件” -> “导入” -> “动画”可将 GIF、PNG、WebP 或 AVI 作为胶片导入，“文件” -> “导入” -> “音频”可将声音放置在时间轴上。
repeating-work = # 重复工作
auto-actions-navigator-palette-records-menu = 自动动作（位于导航器面板中）可录制菜单命令并回放。备品库可保留子工具以便再次添加。“窗口” -> “工作区”可按名称保存面板布局。
exporting = # 导出
file-export-writes-png-jpeg-jpeg = “文件” -> “导出”支持导出 PNG、JPEG、JPEG XL、BMP、TIFF、TGA、PSD 和 PSB。“文件” -> “打印”可将页面排版在纸张上并在 PDF 阅读器中打开。
