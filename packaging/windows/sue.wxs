<?xml version="1.0" encoding="utf-8"?>
<!-- Sue's Windows installer (WiX 5). packaging/windows/build.ps1 passes the
     version, the folder with the files and the architecture:

       wix build sue.wxs -arch x64 -ext WixToolset.UI.wixext -d Version=0.0.1 -d Source=<folder>

     It installs into Program Files, adds Sue to the Start menu, and a newer
     version replaces an older one in place. The UpgradeCode never changes. -->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Sue"
           Manufacturer="MagiGun"
           Version="$(var.Version)"
           UpgradeCode="C7387274-121F-4150-B23C-49B90A593624"
           Scope="perMachine"
           Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of Sue is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="SueIcon" SourceFile="$(var.Source)\sue_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="SueIcon" />
    <Property Id="ARPURLINFOABOUT" Value="https://magigun.github.io/sue/" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/h4Hp2bKrHd" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Sue" />
    </StandardDirectory>

    <ComponentGroup Id="SueFiles" Directory="INSTALLFOLDER">
      <Component>
        <File Source="$(var.Source)\Sue.exe" KeyPath="yes">
          <Shortcut Id="StartMenuSue"
                    Directory="ProgramMenuFolder"
                    Name="Sue"
                    Description="Painting, comics, animation, writing and sound"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="SueIcon"
                    Advertise="yes" />
        </File>
      </Component>
      <Component>
        <File Source="$(var.Source)\sue-cli.exe" />
      </Component>
      <Component>
        <File Source="$(var.Source)\LICENSE.txt" />
      </Component>
      <Component>
        <File Source="$(var.Source)\README.md" />
      </Component>
    </ComponentGroup>

    <Feature Id="Sue" Title="Sue">
      <ComponentGroupRef Id="SueFiles" />
    </Feature>

    <!-- Welcome, license, where to install, install. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.Source)\LICENSE.rtf" />
  </Package>
</Wix>
